    <script>
        // DOM Elements
        const canvas = document.getElementById('drawingCanvas');
        const ctx = canvas.getContext('2d');
        const canvasParent = document.getElementById('canvasParent');
        const sizeSlider = document.getElementById('sizeSlider');
        const sizeValue = document.getElementById('sizeValue');

        // Application State
        let isDrawing = false;
        let currentTool = 'pen'; // 'pen' or 'eraser'
        let currentColor = '#0033aa'; // Default Blue Pen
        let currentSize = 3;
        let showLines = true;
        let lineSpacing = 32; // Line spacing in pixels

        // History Undo/Redo Stacks
        let undoStack = [];
        let redoStack = [];
        const MAX_HISTORY = 20;

        // Touch & Pointer Tracking
        let lastPoint = null;

        // Initialization
        window.addEventListener('load', () => {
            resizeCanvas();
            saveState(); // Save initial state
            updateHistoryButtons();
        });

        window.addEventListener('resize', () => {
            // Re-render canvas properly without blurring or losing progress
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = canvas.width;
            tempCanvas.height = canvas.height;
            const tempCtx = tempCanvas.getContext('2d');
            tempCtx.drawImage(canvas, 0, 0);

            resizeCanvas();
            ctx.drawImage(tempCanvas, 0, 0);
        });

        // Resize Canvas and preserve smooth high-DPI scaling
        function resizeCanvas() {
            const rect = canvasParent.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
            redrawCanvas();
        }

        // Redraw whole canvas (Background lines + current state)
        function redrawCanvas() {
            // Save drawings current content
            const drawingData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            
            // Clear screen
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw realistic cream paper base
            ctx.fillStyle = '#fbf9f4';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Notebook Lines if enabled
            if (showLines) {
                drawNotebookPattern();
            }

            // Restore user drawing on top
            ctx.putImageData(drawingData, 0, 0);
        }

        // Draw ruled notebook paper lines pattern
        function drawNotebookPattern() {
            ctx.save();
            
            // Horizontal blue/grey ruled lines
            ctx.strokeStyle = '#c5d3e8'; // Classic faint notebook line color
            ctx.lineWidth = 1;
            
            const topMargin = 40;
            for (let y = topMargin; y < canvas.height; y += lineSpacing) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
            }

            // Vertical Red Margin Line (Left side)
            const redMarginX = 50; // Margin line position
            ctx.strokeStyle = '#ff9999'; // Faint red margin color
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(redMarginX, 0);
            ctx.lineTo(redMarginX, canvas.height);
            ctx.stroke();

            ctx.restore();
        }

        // Save State for Undo/Redo
        function saveState() {
            if (undoStack.length >= MAX_HISTORY) {
                undoStack.shift();
            }
            undoStack.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
            redoStack = []; // Clear redo stack on new action
            updateHistoryButtons();
        }

        function undo() {
            if (undoStack.length > 1) {
                redoStack.push(undoStack.pop());
                const previousState = undoStack[undoStack.length - 1];
                ctx.putImageData(previousState, 0, 0);
                updateHistoryButtons();
                showToast("تم التراجع");
            }
        }

        function redo() {
            if (redoStack.length > 0) {
                const nextState = redoStack.pop();
                undoStack.push(nextState);
                ctx.putImageData(nextState, 0, 0);
                updateHistoryButtons();
                showToast("تمت الإعادة");
            }
        }

        function updateHistoryButtons() {
            document.getElementById('undoBtn').disabled = undoStack.length <= 1;
            document.getElementById('redoBtn').disabled = redoStack.length === 0;
        }

        // Tool Selection Handling
        function setTool(tool, color = null) {
            currentTool = tool;
            
            // Reset active states
            document.querySelectorAll('.pen-btn').forEach(btn => btn.classList.remove('active'));

            if (tool === 'pen') {
                if (color) currentColor = color;
                if (currentColor === '#0033aa') document.getElementById('penBlue').classList.add('active');
                if (currentColor === '#cc1100') document.getElementById('penRed').classList.add('active');
                if (currentColor === '#222222') document.getElementById('penBlack').classList.add('active');
            } else if (tool === 'eraser') {
                document.getElementById('eraserBtn').classList.add('active');
            }
        }

        // Toggle Lined Pattern Background
        function toggleNotebookLines() {
            showLines = !showLines;
            const btn = document.getElementById('toggleLinesBtn');
            if (showLines) {
                btn.classList.add('text-amber-400');
                btn.classList.remove('text-stone-400');
            } else {
                btn.classList.remove('text-amber-400');
                btn.classList.add('text-stone-400');
            }

            // Create temporary canvas to hold current stroke data
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = canvas.width;
            tempCanvas.height = canvas.height;
            const tempCtx = tempCanvas.getContext('2d');
            tempCtx.drawImage(canvas, 0, 0);

            // Re-render notebook background and put user drawing back
            redrawCanvas();
            showToast(showLines ? "تم إظهار الأسطر" : "تم إخفاء الأسطر");
        }

        // Slider Size Control
        sizeSlider.addEventListener('input', (e) => {
            currentSize = e.target.value;
            sizeValue.textContent = currentSize;
        });

        // Get Coordinates Helper (Touch & Mouse support)
        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            let clientX = e.clientX;
            let clientY = e.clientY;

            if (e.touches && e.touches.length > 0) {
                clientX = e.touches[0].clientX;
                clientY = e.touches[0].clientY;
            }

            return {
                x: clientX - rect.left,
                y: clientY - rect.top
            };
        }

        // Drawing Logic
        function startDrawing(e) {
            e.preventDefault();
            isDrawing = true;
            lastPoint = getPos(e);
            
            ctx.beginPath();
            ctx.moveTo(lastPoint.x, lastPoint.y);
        }

        function draw(e) {
            if (!isDrawing) return;
            e.preventDefault();

            const currentPoint = getPos(e);

            ctx.lineWidth = currentSize;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            if (currentTool === 'eraser') {
                // Eraser mode: Erase to paper color or redraw background underneath
                ctx.strokeStyle = '#fbf9f4';
                ctx.beginPath();
                ctx.moveTo(lastPoint.x, lastPoint.y);
                ctx.lineTo(currentPoint.x, currentPoint.y);
                ctx.stroke();

                // Restore notebook lines if enabled in erased region
                if (showLines) {
                    restoreLinesInArea(lastPoint, currentPoint, currentSize);
                }
            } else {
                // Ballpoint Pen effect with subtle pressure texture
                ctx.strokeStyle = currentColor;
                ctx.globalAlpha = 0.92; // Realistic ballpoint ink translucency
                ctx.beginPath();
                ctx.moveTo(lastPoint.x, lastPoint.y);
                ctx.lineTo(currentPoint.x, currentPoint.y);
                ctx.stroke();
                ctx.globalAlpha = 1.0;
            }

            lastPoint = currentPoint;
        }

        function stopDrawing(e) {
            if (isDrawing) {
                isDrawing = false;
                ctx.closePath();
                saveState(); // Save state for undo/redo
            }
        }

        // Restore notebook lines when eraser is used
        function restoreLinesInArea(p1, p2, radius) {
            ctx.save();
            const topMargin = 40;
            const redMarginX = 50;
            
            // Calculate bounding box around erase stroke
            const minX = Math.min(p1.x, p2.x) - radius;
            const maxX = Math.max(p1.x, p2.x) + radius;
            const minY = Math.min(p1.y, p2.y) - radius;
            const maxY = Math.max(p1.y, p2.y) + radius;

            // Clip to erased area
            ctx.beginPath();
            ctx.rect(minX, minY, maxX - minX, maxY - minY);
            ctx.clip();

            // Redraw horizontal blue lines in clipped region
            ctx.strokeStyle = '#c5d3e8';
            ctx.lineWidth = 1;
            for (let y = topMargin; y < canvas.height; y += lineSpacing) {
                if (y >= minY - 5 && y <= maxY + 5) {
                    ctx.beginPath();
                    ctx.moveTo(minX, y);
                    ctx.lineTo(maxX, y);
                    ctx.stroke();
                }
            }

            // Redraw vertical red margin line if in clipped region
            if (redMarginX >= minX - 5 && redMarginX <= maxX + 5) {
                ctx.strokeStyle = '#ff9999';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(redMarginX, minY);
                ctx.lineTo(redMarginX, maxY);
                ctx.stroke();
            }

            ctx.restore();
        }

        // Clear All Canvas
        function clearCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#fbf9f4';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            if (showLines) {
                drawNotebookPattern();
            }
            saveState();
            showToast("تم مسح الصفحة بالكامل");
        }

